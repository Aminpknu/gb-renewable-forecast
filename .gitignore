# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.matplotlib/
.coverage
.coverage.*
htmlcov/

# Python packaging and environments
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/

# Conda
.conda/
conda-meta/
*.conda

# Jupyter
.ipynb_checkpoints/

# Editors and IDEs
.vscode/
.idea/
*.code-workspace
*.iml

# Windows
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# Temporary and log files
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
*.log

# Secrets and local environment configuration
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Downloaded and generated datasets
data/raw/*
!data/raw/.gitkeep
!data/raw/neso/
data/raw/neso/*
!data/raw/neso/source_manifest.json
!data/raw/weather/
data/raw/weather/*
!data/raw/weather/source_manifest.json
!data/raw/weather/excluded_target_dates.json
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated model artefacts
models/*
!models/.gitkeep
!models/model_metadata.json
*.joblib
*.pkl
*.pickle
!models/wind_xgboost.joblib
!models/solar_extratrees.joblib

# Generated outputs; small examples may live elsewhere under outputs/
outputs/figures/*
!outputs/figures/.gitkeep
!outputs/figures/wind_test_forecast_vs_actual.png
!outputs/figures/solar_test_forecast_vs_actual.png
!outputs/figures/model_vs_baseline_mae.png
outputs/forecasts/*
!outputs/forecasts/.gitkeep
!outputs/forecasts/latest_forecast.csv
!outputs/forecasts/latest_forecast_summary.json
outputs/metrics/*
!outputs/metrics/.gitkeep
!outputs/metrics/final_test_metrics.csv
!outputs/metrics/final_test_predictions.csv
